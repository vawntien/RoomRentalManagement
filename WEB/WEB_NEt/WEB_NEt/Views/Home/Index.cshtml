@{
    ViewBag.Title = "Home";
}

@section Styles {
    <style>
        body {
            font-family: 'Source Sans Pro', sans-serif;
            background: #f7f7f7;
            overflow-x: hidden;
        }

        /* Hero Section */
        .jumbotron-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6rem 10%;
            height: 85vh;
            /* Gradient sang trọng */
            background: linear-gradient(135deg, #ffffff 0%, #f0f0f0 40%, #e8e8e8 100%);
            border-bottom: 1px solid #ddd;
            animation: fadeIn 1.2s ease-out;
        }

        /* Text bên trái */
        .jumbotron-left {
            flex: 1;
            animation: slideInLeft 1s ease-out;
        }

        .jumbotron-header {
            font-size: 3.4rem;
            font-weight: 800;
            line-height: 1.25;
            color: #222;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, #000, #555);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textGlow 3s ease-in-out infinite alternate;
        }

        .jumbotron-left p {
            font-size: 1.25rem;
            color: #555;
            margin-bottom: 2.5rem;
        }

        .jumbotron-right {
            flex: 0.6;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;
            gap: 1.5rem;
            animation: slideInRight 1s ease-out;
        }


        .btn-fill {
            background: #d4af37;
            color: #fff;
            padding: 1rem 3rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.2rem;
            border: none;
            cursor: pointer;
            transition: 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
        }

            .btn-fill:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(212, 175, 55, 0.6);
            }

        /* Animation */
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideInLeft {
            from {
                transform: translateX(-50px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes slideInRight {
            from {
                transform: translateX(50px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes textGlow {
            from {
                text-shadow: 0 0 5px rgba(0,0,0,0.1);
            }

            to {
                text-shadow: 0 0 20px rgba(0,0,0,0.25);
            }
        }
    </style>
}

<div class="jumbotron-container">
    <div class="jumbotron-left">
        <h2 class="jumbotron-header">
            Discover the perfect balance <br>
            of hospitality, luxury and <br>
            comfort.
        </h2>


    </div>

    <div class="jumbotron-right">
        <p>
            We are focused on providing clients with the highest level
            of comfort and excellent affordable rates.
        </p>
        <a href="@Url.Action("Index","Room")" class="btn-fill">Book Now</a>
    </div>
</div>
