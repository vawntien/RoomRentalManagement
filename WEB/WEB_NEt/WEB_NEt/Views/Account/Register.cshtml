@model WEB_NEt.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
}

<h2 class="text-center">Đăng ký tài khoản mới</h2>
<hr />

<div class="row">
    <div class="col-md-8 offset-md-2">

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <h4>Thông tin cá nhân</h4>
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.HoTen, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Họ và tên" })
                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.CCCD, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", placeholder = "CCCD/CMND" })
                @Html.ValidationMessageFor(m => m.CCCD, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.SoDT, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.SoDT, new { @class = "form-control", placeholder = "Số điện thoại" })
                @Html.ValidationMessageFor(m => m.SoDT, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.NgaySinh, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger" })
            </div>

            <hr />
            <h4>Thông tin tài khoản</h4>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.TaiKhoan, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.TaiKhoan, new { @class = "form-control", placeholder = "Tên đăng nhập" })
                @Html.ValidationMessageFor(m => m.TaiKhoan, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.MatKhau, new { @class = "control-label" })
                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Mật khẩu" })
                @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "control-label" })
                @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3 text-center">
                <button type="submit" class="btn btn-primary btn-lg">Đăng ký</button>
            </div>

            <div class="text-center">
                @Html.ActionLink("Bạn đã có tài khoản? Đăng nhập ngay", "Login")
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}